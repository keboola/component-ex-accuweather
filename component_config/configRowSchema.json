{
  "type": "object",
  "title": "Location",
  "required": [
    "location_type",
    "datasets"
  ],
  "properties": {
    "location_type": {
      "type": "string",
      "title": "Location Type",
      "enum": [
        "city",
        "postal_code",
        "geoposition",
        "location_key"
      ],
      "default": "city",
      "description": "How this location is identified.",
      "propertyOrder": 10,
      "options": {
        "enum_titles": [
          "City name",
          "Postal code",
          "Geo-position (latitude/longitude)",
          "AccuWeather location key"
        ]
      }
    },
    "city_query": {
      "type": "string",
      "title": "City name",
      "description": "City name to search.",
      "propertyOrder": 20,
      "options": {
        "tooltip": "City name to search, e.g. Prague. Add a Country code to disambiguate.",
        "dependencies": {
          "location_type": "city"
        }
      }
    },
    "postal_query": {
      "type": "string",
      "title": "Postal code",
      "description": "Postal/ZIP code to look up.",
      "propertyOrder": 20,
      "options": {
        "tooltip": "Postal/ZIP code, e.g. 11000. A Country code is required for postal lookup.",
        "dependencies": {
          "location_type": "postal_code"
        }
      }
    },
    "location_search": {
      "type": "string",
      "title": "Location search",
      "description": "Search term used by the Search locations helper.",
      "propertyOrder": 20,
      "options": {
        "tooltip": "Search by city or postal code to find the key, or paste a known key below.",
        "dependencies": {
          "location_type": "location_key"
        }
      }
    },
    "country_code": {
      "type": "string",
      "title": "Country Code",
      "description": "ISO 3166 country code to disambiguate the search.",
      "propertyOrder": 30,
      "options": {
        "tooltip": "Two-letter ISO country code, e.g. US, GB, CZ. Narrows the city or postal code search. Required for postal code lookup.",
        "dependencies": {
          "location_type": [
            "city",
            "postal_code",
            "location_key"
          ]
        }
      }
    },
    "latitude": {
      "type": "number",
      "title": "Latitude",
      "description": "Latitude in decimal degrees.",
      "propertyOrder": 40,
      "options": {
        "dependencies": {
          "location_type": "geoposition"
        }
      }
    },
    "longitude": {
      "type": "number",
      "title": "Longitude",
      "description": "Longitude in decimal degrees.",
      "propertyOrder": 50,
      "options": {
        "dependencies": {
          "location_type": "geoposition"
        }
      }
    },
    "location_key": {
      "type": "string",
      "title": "Location Key",
      "format": "select",
      "enum": [],
      "description": "AccuWeather location key.",
      "propertyOrder": 60,
      "options": {
        "tooltip": "Enter a known AccuWeather location key, or type a Location search above and click Search locations to pick one.",
        "creatable": true,
        "async": {
          "label": "Search locations",
          "action": "search_locations"
        },
        "dependencies": {
          "location_type": "location_key"
        }
      }
    },
    "datasets": {
      "type": "array",
      "title": "Datasets",
      "format": "select",
      "uniqueItems": true,
      "default": [
        "current_conditions"
      ],
      "description": "Which weather datasets to pull for this location.",
      "propertyOrder": 70,
      "items": {
        "type": "string",
        "enum": [
          "current_conditions",
          "daily_forecast",
          "hourly_forecast",
          "indices"
        ],
        "options": {
          "enum_titles": [
            "Current conditions",
            "Daily forecast",
            "Hourly forecast",
            "Lifestyle indices"
          ]
        }
      }
    },
    "daily_range": {
      "type": "integer",
      "title": "Daily Forecast Range",
      "enum": [
        1,
        5,
        10,
        15
      ],
      "default": 5,
      "description": "Number of forecast days to request.",
      "propertyOrder": 80,
      "options": {
        "enum_titles": [
          "1 day",
          "5 days",
          "10 days",
          "15 days"
        ],
        "dependencies": {
          "datasets": [
            "daily_forecast",
            "indices"
          ]
        }
      }
    },
    "hourly_range": {
      "type": "integer",
      "title": "Hourly Forecast Range",
      "enum": [
        1,
        12,
        24,
        72,
        120
      ],
      "default": 12,
      "description": "Number of forecast hours to request.",
      "propertyOrder": 90,
      "options": {
        "enum_titles": [
          "1 hour",
          "12 hours",
          "24 hours",
          "72 hours",
          "120 hours"
        ],
        "dependencies": {
          "datasets": [
            "hourly_forecast"
          ]
        }
      }
    }
  }
}
