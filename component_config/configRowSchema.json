{
  "type": "object",
  "title": "Location",
  "required": [
    "location_type"
  ],
  "properties": {
    "location_type": {
      "type": "string",
      "title": "Location Type",
      "enum": [
        "search",
        "geoposition"
      ],
      "default": "search",
      "description": "How this location is identified.",
      "propertyOrder": 10,
      "options": {
        "enum_titles": [
          "Search",
          "Geo"
        ]
      }
    },
    "location_search": {
      "type": "string",
      "title": "Search",
      "description": "City name or postal code to search for.",
      "propertyOrder": 20,
      "options": {
        "tooltip": "Type a city name (e.g. Prague) or a postal/ZIP code (e.g. 110 00, 10001). Then use Find & confirm location to look up and pick the matching AccuWeather location key.",
        "dependencies": {
          "location_type": "search"
        }
      }
    },
    "latitude": {
      "type": "number",
      "title": "Latitude",
      "description": "Latitude in decimal degrees.",
      "propertyOrder": 40,
      "options": {
        "dependencies": {
          "location_type": "geoposition"
        }
      }
    },
    "longitude": {
      "type": "number",
      "title": "Longitude",
      "description": "Longitude in decimal degrees.",
      "propertyOrder": 50,
      "options": {
        "dependencies": {
          "location_type": "geoposition"
        }
      }
    },
    "location_key": {
      "type": "string",
      "title": "Confirmed Location Key",
      "format": "select",
      "enum": [],
      "description": "You must confirm the location here — use Find & confirm location to search and pick the match, or paste a known AccuWeather location key.",
      "propertyOrder": 25,
      "options": {
        "tooltip": "Click Find & confirm location to search using the query above and pick a match, or paste a known AccuWeather location key here.",
        "creatable": true,
        "async": {
          "label": "Find & confirm location",
          "action": "search_locations"
        },
        "dependencies": {
          "location_type": "search"
        }
      }
    },
    "datasets": {
      "type": "object",
      "title": "Datasets",
      "description": "Which weather datasets to pull for this location.",
      "propertyOrder": 70,
      "properties": {
        "current_conditions": {
          "type": "boolean",
          "title": "Current Conditions",
          "format": "checkbox",
          "default": true,
          "description": "Latest observed conditions for the location.",
          "propertyOrder": 10
        },
        "current_conditions_details": {
          "type": "boolean",
          "title": "Current Conditions – Include Full Details",
          "format": "checkbox",
          "default": false,
          "description": "Fetch the extended detail fields for current conditions.",
          "propertyOrder": 20,
          "options": {
            "tooltip": "Adds extra columns to the current conditions table: realfeel_temperature, relative_humidity, wind_speed, uv_index, visibility, cloud_cover and pressure.",
            "dependencies": {
              "current_conditions": true
            }
          }
        },
        "daily_forecast": {
          "type": "boolean",
          "title": "Daily Forecast",
          "format": "checkbox",
          "default": false,
          "description": "Multi-day daily forecast for the location.",
          "propertyOrder": 30
        },
        "daily_range": {
          "type": "integer",
          "title": "Daily Forecast Range",
          "enum": [
            1,
            5,
            10,
            15
          ],
          "default": 5,
          "description": "Number of forecast days to request.",
          "propertyOrder": 40,
          "options": {
            "enum_titles": [
              "1 day",
              "5 days",
              "10 days",
              "15 days"
            ],
            "dependencies": {
              "daily_forecast": true
            }
          }
        },
        "daily_forecast_details": {
          "type": "boolean",
          "title": "Daily Forecast – Include Full Details",
          "format": "checkbox",
          "default": false,
          "description": "Fetch the extended detail fields for the daily forecast.",
          "propertyOrder": 50,
          "options": {
            "tooltip": "Adds extra columns to the daily forecast table: realfeel_temperature_min/max, hours_of_sun, day/night wind speed and direction, day/night thunderstorm and rain probability, uv_index and air_quality_category.",
            "dependencies": {
              "daily_forecast": true
            }
          }
        },
        "hourly_forecast": {
          "type": "boolean",
          "title": "Hourly Forecast",
