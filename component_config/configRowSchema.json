          "default": 12,
          "description": "Number of forecast hours to request.",
          "propertyOrder": 70,
          "options": {
            "enum_titles": [
              "1 hour",
              "12 hours",
              "24 hours",
              "72 hours",
              "120 hours"
            ],
            "dependencies": {
              "hourly_forecast": true
            }
          }
        },
        "hourly_forecast_details": {
          "type": "boolean",
          "title": "Hourly Forecast – Include Full Details",
          "format": "checkbox",
          "default": false,
          "description": "Fetch the extended detail fields for the hourly forecast.",
          "propertyOrder": 80,
          "options": {
            "tooltip": "Adds extra columns to the hourly forecast table: realfeel_temperature, wind_speed and wind_direction, relative_humidity, dew_point, uv_index, visibility, cloud_cover, precipitation_type and rain amount.",
