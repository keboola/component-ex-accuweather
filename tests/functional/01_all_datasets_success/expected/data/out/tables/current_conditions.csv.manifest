      "data_type": {
        "base": {
          "type": "NUMERIC"
        }
      },
      "nullable": true
    },
    {
      "name": "relative_humidity",
      "data_type": {
        "base": {
          "type": "INTEGER"
        }
      },
      "nullable": true
    },
    {
      "name": "wind_speed",
      "data_type": {
        "base": {
          "type": "NUMERIC"
        }
      },
      "nullable": true
    },
    {
