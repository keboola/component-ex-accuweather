{
  "incremental": true,
  "write_always": false,
  "delimiter": ",",
  "enclosure": "\"",
  "manifest_type": "out",
  "has_header": false,
  "schema": [
    {
      "name": "location_key",
      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "primary_key": true
    },
    {
      "name": "observation_datetime",
      "data_type": {
        "base": {
          "type": "TIMESTAMP"
        }
      },
      "primary_key": true
    },
    {
      "name": "epoch_time",
      "data_type": {
        "base": {
          "type": "INTEGER"
        }
      },
      "nullable": true
    },
    {
      "name": "weather_text",
      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "nullable": true
    },
    {
