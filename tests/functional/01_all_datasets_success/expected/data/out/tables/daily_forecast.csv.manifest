      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "nullable": true
    },
    {
      "name": "mobile_link",
      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "nullable": true
    }
  ]
}
