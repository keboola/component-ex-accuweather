{
  "incremental": true,
  "write_always": false,
  "delimiter": ",",
  "enclosure": "\"",
  "manifest_type": "out",
  "has_header": false,
  "schema": [
    {
      "name": "location_key",
      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "primary_key": true
    },
    {
      "name": "forecast_date",
      "data_type": {
        "base": {
          "type": "TIMESTAMP"
        }
      },
      "primary_key": true
    },
    {
      "name": "epoch_date",
      "data_type": {
        "base": {
          "type": "INTEGER"
        }
      },
      "nullable": true
    },
    {
      "name": "temperature_min",
      "data_type": {
        "base": {
          "type": "NUMERIC"
        }
      },
      "nullable": true
    },
    {
      "name": "temperature_max",
      "data_type": {
        "base": {
          "type": "NUMERIC"
        }
      },
      "nullable": true
    },
    {
      "name": "temperature_unit",
      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "nullable": true
    },
    {
      "name": "day_icon",
      "data_type": {
        "base": {
          "type": "INTEGER"
        }
      },
      "nullable": true
    },
    {
      "name": "day_phrase",
      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "nullable": true
    },
    {
      "name": "day_precipitation_probability",
      "data_type": {
        "base": {
          "type": "INTEGER"
        }
      },
      "nullable": true
    },
    {
      "name": "day_has_precipitation",
      "data_type": {
        "base": {
          "type": "BOOLEAN"
        }
      },
      "nullable": true
    },
    {
      "name": "night_icon",
      "data_type": {
        "base": {
          "type": "INTEGER"
        }
      },
      "nullable": true
    },
    {
      "name": "night_phrase",
      "data_type": {
        "base": {
          "type": "STRING"
        }
      },
      "nullable": true
    },
    {
      "name": "night_precipitation_probability",
      "data_type": {
        "base": {
          "type": "INTEGER"
        }
      },
      "nullable": true
    },
    {
      "name": "sun_rise",
      "data_type": {
        "base": {
          "type": "TIMESTAMP"
        }
      },
      "nullable": true
    },
    {
      "name": "sun_set",
      "data_type": {
        "base": {
          "type": "TIMESTAMP"
        }
      },
      "nullable": true
    },
    {
